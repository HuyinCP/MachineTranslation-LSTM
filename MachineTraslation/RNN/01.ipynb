     "output_type": "stream",
     "text": [
      "shape Wax = torch.Size([100, 10000])\n",
      "shape x = torch.Size([10000, 1])\n",
      "shape a_next = torch.Size([100, 1])\n"
     ]
    }
   ],
   "source": [
    "\n",
    "Wax = torch.rand((100, 10000))\n",
    "x = torch.rand((10000, 1))\n",
    "\n",
    "Waa = torch.rand((100, 100))\n",
    "a = torch.rand((100, 1))\n",
    "\n",
    "ba = torch.rand((100, 1))\n",
    "\n",
    "a_next = torch.tanh(Waa @ a + Wax @ x + ba)\n",
    "print(f\"shape a_next = {a_next.shape}\")"
   ]
